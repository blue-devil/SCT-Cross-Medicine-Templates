// Windows resources. GLFW loads "GLFW_ICON" for the window class (title bar,
// taskbar, Alt+Tab); Explorer shows the first icon group in the exe.
GLFW_ICON ICON "assets/icon/sct.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "SCT"
      VALUE "FileDescription",  "SCT Template (raylib + raygui)"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "sct"
      VALUE "OriginalFilename", "sct.exe"
      VALUE "ProductName",      "SCT Cross Medicine Template"
      VALUE "ProductVersion",   "1.0.0.0"
      VALUE "LegalCopyright",   "SCT-PL"
      VALUE "Author",           "Blue DeviL"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
