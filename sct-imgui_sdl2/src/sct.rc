// Windows resources. SDL2 sets the window icon at runtime from the embedded
// PNG; Explorer (and the file properties sheet) show this resource instead.
GLFW_ICON ICON "assets/icon/sct.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "SCT"
      VALUE "FileDescription",  "SCT Template (SDL2 + Dear ImGui)"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "sct"
      VALUE "OriginalFilename", "sct.exe"
      VALUE "ProductName",      "SCT Cross Medicine Template"
      VALUE "ProductVersion",   "1.0.0.0"
      VALUE "LegalCopyright",   "SCT-PL"
      VALUE "Author",           "Blue DeviL"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
